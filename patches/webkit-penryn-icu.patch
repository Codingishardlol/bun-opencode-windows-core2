diff --git a/build-icu.ps1 b/build-icu.ps1
index de165754..fa4fec67 100644
--- a/build-icu.ps1
+++ b/build-icu.ps1
@@ -78,7 +78,7 @@ $ICU_SOURCE_STAMP = Join-Path $OutputDir "source-version.txt"
 if (Test-Path $ICU_SOURCE_DIR) {
     $have = if (Test-Path $ICU_SOURCE_STAMP) { (Get-Content $ICU_SOURCE_STAMP -Raw).Trim() } else { "" }
     if ($have -ne $ICU_VERSION) {
-        Write-Host ":: $ICU_SOURCE_DIR is ICU '$have', not $ICU_VERSION: removing it"
+        Write-Host ":: $ICU_SOURCE_DIR is ICU '$have', not ${ICU_VERSION}: removing it"
         Remove-Item -Recurse -Force $ICU_SOURCE_DIR
     }
 }
@@ -99,14 +99,17 @@ if (-not (Test-Path $ICU_SOURCE_DIR)) {
     Write-Host ":: Extracting ICU"
     # ICU tarball extracts to icu/ directory
     $extractDir = Split-Path -Parent $OutputDir
-    tar.exe -xzf $ICU_TARBALL -C $extractDir
+    # Use Windows' own bsdtar, not whatever "tar.exe" comes first on PATH: with Git for Windows / Cygwin on PATH that is
+    # GNU tar, which reads "C:\..." as host:path ("Cannot connect to C: resolve failed").
+    $winTar = Join-Path $env:SystemRoot "System32\tar.exe"
+    & $winTar -xzf $ICU_TARBALL -C $extractDir
     if ($LASTEXITCODE -ne 0) { throw "tar failed with exit code $LASTEXITCODE" }
     Set-Content -Path $ICU_SOURCE_STAMP -Value $ICU_VERSION
 }
 
 # The code generation floor, the same as the lanes that ship (.github/scripts/lanes.mjs).
 if ($Platform -eq "x64") {
-    $ArchFlag = "/clang:-march=nehalem"
+    $ArchFlag = if ($env:BUN_CORE2_BUILD -eq "1") { "/clang:-march=penryn" } else { "/clang:-march=nehalem" }
 } else {
     $ArchFlag = "/clang:-march=armv8-a+crc"
 }
